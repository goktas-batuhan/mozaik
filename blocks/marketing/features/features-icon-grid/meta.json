{
  "name": "features-icon-grid",
  "title": "Features Icon Grid",
  "description": "A headline over a responsive grid of icon cards that rise in one after another.",
  "group": "marketing",
  "shelf": "features",
  "layer": "block",
  "tags": [
    "in-view",
    "css",
    "marketing"
  ],
  "keywords": [
    "features",
    "grid",
    "icons",
    "cards"
  ],
  "source": {
    "repo": "educlopez/smoothui",
    "license": "MIT",
    "url": "https://github.com/educlopez/smoothui/blob/main/packages/smoothui/blocks/features/features-1/index.tsx"
  },
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [],
  "props": [
    {
      "name": "description",
      "type": "ReactNode",
      "description": "Copy under the headline."
    },
    {
      "name": "eyebrow",
      "type": "ReactNode",
      "description": "Small pill above the headline."
    },
    {
      "name": "features",
      "type": "{ title: string; description: ReactNode; icon?: ReactNode }[]",
      "required": true,
      "description": "The features, laid out as cards."
    },
    {
      "name": "columns",
      "type": "2 | 3 | 4",
      "default": "3",
      "description": "Columns on wide containers."
    },
    {
      "name": "duration",
      "type": "number",
      "default": "0.5",
      "description": "Seconds each card takes to fade in."
    },
    {
      "name": "stagger",
      "type": "number",
      "default": "0.06",
      "description": "Seconds between cards."
    },
    {
      "name": "title",
      "type": "ReactNode",
      "required": true,
      "description": "Section headline. Labels the section for assistive tech."
    },
    {
      "name": "titleAs",
      "type": "ElementType",
      "default": "'h2'",
      "description": "Element for the headline."
    },
    {
      "name": "as",
      "type": "ElementType",
      "default": "'section'",
      "description": "Element for the root."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false",
      "description": "Turns the entrance animation off."
    },
    {
      "name": "className",
      "type": "string",
      "description": "Extra classes for the root element."
    }
  ]
}
