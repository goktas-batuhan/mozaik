{
  "name": "footer-bento",
  "title": "Footer Bento",
  "description": "Footer built as a bento of cards: a call to action, social pills, a company link list and a legal strip.",
  "group": "marketing",
  "shelf": "footer",
  "layer": "block",
  "tags": ["css", "marketing"],
  "keywords": ["footer", "bento", "cards", "cta"],
  "source": { "repo": "ui-layouts/uilayouts", "license": "MIT", "url": "https://github.com/ui-layouts/uilayouts/blob/main/packages/blocks/src/footer-section/footer-bento.tsx" },
  "dependencies": [],
  "registryDependencies": [],
  "props": [
    { "name": "mark", "type": "ReactNode", "description": "Icon in the large card. Decorative." },
    { "name": "title", "type": "ReactNode", "required": true, "description": "Heading of the large card." },
    { "name": "description", "type": "ReactNode", "description": "Copy under the heading." },
    { "name": "primaryAction", "type": "{ label: string; href: string }", "description": "Filled link in the large card." },
    { "name": "secondaryAction", "type": "{ label: string; href: string }", "description": "Outlined link next to the primary one." },
    { "name": "social", "type": "{ label: string; href: string }[]", "default": "[]", "description": "Pills in the Connect card." },
    { "name": "links", "type": "{ label: string; href: string }[]", "default": "[]", "description": "Links in the Company card." },
    { "name": "copyright", "type": "ReactNode", "description": "Text of the bottom strip." },
    { "name": "legalLinks", "type": "{ label: string; href: string }[]", "default": "[]", "description": "Small links in the bottom strip." },
    { "name": "as", "type": "ElementType", "default": "'footer'", "description": "Element for the root." },
    { "name": "className", "type": "string", "description": "Extra classes for the root element." }
  ]
}
