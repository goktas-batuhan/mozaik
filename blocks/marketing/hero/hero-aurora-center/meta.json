{
  "name": "hero-aurora-center",
  "title": "Hero Aurora Center",
  "description": "Full-bleed hero on a drifting aurora with a glass strip of three highlights along the bottom.",
  "group": "marketing",
  "shelf": "hero",
  "layer": "block",
  "tags": [
    "loop",
    "css",
    "marketing"
  ],
  "keywords": [
    "hero",
    "aurora",
    "gradient",
    "glass",
    "highlights"
  ],
  "source": "original",
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [
    "aurora-background"
  ],
  "props": [
    {
      "name": "title",
      "type": "ReactNode",
      "required": true,
      "description": "The headline."
    },
    {
      "name": "description",
      "type": "ReactNode",
      "description": "Supporting copy."
    },
    {
      "name": "primaryAction",
      "type": "{ label: ReactNode; href?: string; onClick?: () => void }",
      "description": "Filled call to action."
    },
    {
      "name": "secondaryAction",
      "type": "{ label: ReactNode; href?: string; onClick?: () => void }",
      "description": "Outlined call to action."
    },
    {
      "name": "highlights",
      "type": "{ title: string; text: string }[]",
      "description": "Selling points shown in the glass strip."
    },
    {
      "name": "intensity",
      "type": "number",
      "default": "0.7",
      "description": "Brightness of the aurora, 0 to 1."
    },
    {
      "name": "duration",
      "type": "number",
      "default": "0.6",
      "description": "Seconds each piece takes to fade in."
    },
    {
      "name": "stagger",
      "type": "number",
      "default": "0.08",
      "description": "Seconds between pieces."
    },
    {
      "name": "delay",
      "type": "number",
      "default": "0",
      "description": "Seconds before the first piece."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false",
      "description": "Turns the entrance animation off."
    },
    {
      "name": "className",
      "type": "string",
      "description": "Extra classes for the root element."
    }
  ]
}
