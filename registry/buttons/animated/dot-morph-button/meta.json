{
  "name": "dot-morph-button",
  "title": "Dot Morph Button",
  "description": "A pill button whose leading dot springs into a tall bar on hover and keyboard focus. Stays a dot on touch screens and under reduced motion.",
  "group": "buttons",
  "shelf": "animated",
  "layer": "component",
  "tags": ["hover", "css", "marketing"],
  "keywords": ["button", "dot", "morph", "pill", "cta"],
  "source": { "repo": "educlopez/smoothui", "license": "MIT", "url": "https://github.com/educlopez/smoothui/blob/main/packages/smoothui/components/dot-morph-button/index.tsx" },
  "dependencies": ["motion"],
  "props": [
    { "name": "label", "type": "string", "description": "Text next to the dot." },
    { "name": "disabled", "type": "boolean", "default": "false", "description": "Disables the button." },
    { "name": "onClick", "type": "MouseEventHandler<HTMLButtonElement>", "description": "Called when the button is pressed." },
    { "name": "className", "type": "string", "description": "Extra classes for the button." }
  ]
}
