{
  "name": "week-strip-calendar",
  "title": "Week Strip Calendar",
  "description": "A one-week date strip: step between weeks with the arrows and tap a day to select it.",
  "group": "inputs",
  "shelf": "pickers",
  "layer": "component",
  "tags": ["click", "css", "dashboard"],
  "keywords": ["calendar", "date", "week", "strip", "scheduler"],
  "source": { "repo": "bidyut10/opensourceui", "license": "MIT", "url": "https://github.com/bidyut10/opensourceui/blob/main/components/calender/week-strip-calendar.tsx" },
  "dependencies": ["motion"],
  "props": [
    { "name": "value", "type": "Date", "description": "Controlled selected day." },
    { "name": "defaultValue", "type": "Date", "default": "today", "description": "Initially selected day when uncontrolled." },
    { "name": "onChange", "type": "(date: Date) => void", "description": "Called with the picked day at local midnight." },
    { "name": "className", "type": "string", "description": "Extra classes for the card." }
  ]
}
