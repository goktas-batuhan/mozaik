{
  "name": "liquid-slider",
  "title": "Liquid Slider",
  "description": "A glass of water you fill by dragging its surface. The liquid sloshes and bubbles; under reduced motion it just rises.",
  "group": "inputs",
  "shelf": "sliders-dials",
  "layer": "component",
  "tags": ["drag", "svg"],
  "keywords": ["slider", "water", "fluid", "wave", "glass", "physics"],
  "source": { "repo": "kokonut-labs/kokonutui", "license": "MIT", "url": "https://github.com/kokonut-labs/kokonutui/blob/main/components/kokonutui/liquid-slider.tsx" },
  "dependencies": ["motion"],
  "props": [
    { "name": "value", "type": "number", "description": "Controlled value." },
    { "name": "defaultValue", "type": "number", "default": "1250", "description": "Initial value when uncontrolled." },
    { "name": "onValueChange", "type": "(value: number) => void", "description": "Called with the new value while dragging or using the keyboard." },
    { "name": "min", "type": "number", "default": "0", "description": "Value of an empty glass." },
    { "name": "max", "type": "number", "default": "2000", "description": "Value of a full glass." },
    { "name": "step", "type": "number", "default": "50", "description": "Step the value snaps to." },
    { "name": "unit", "type": "string", "default": "'ml'", "description": "Shown after the number." },
    { "name": "label", "type": "string", "default": "'Water today'", "description": "Heading above the readout. Also the accessible name." },
    { "name": "formatValue", "type": "(value: number) => string", "description": "Formats the readout, the scale and aria-valuetext." },
    { "name": "className", "type": "string", "description": "Extra classes for the wrapper." }
  ]
}
