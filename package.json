{
  "name": "mozaik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A growing collection of React components in one design language, distributed as a shadcn registry.",
  "license": "MIT",
  "scripts": {
    "link": "node scripts/link-components.mjs",
    "predev": "npm run link",
    "dev": "vite",
    "registry:build": "node scripts/build-registry.mjs",
    "pretypecheck": "npm run link",
    "typecheck": "tsc -b",
    "pretest": "npm run link",
    "test": "vitest run",
    "smoke": "playwright test",
    "gate": "node scripts/gate.mjs",
    "build": "npm run typecheck && npm run registry:build && vite build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.61.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
